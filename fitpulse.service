
[Unit]
Description=FitPulse Pro Telegram Intelligence Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fitpulse
Group=fitpulse
WorkingDirectory=/opt/fitpulse
EnvironmentFile=/opt/fitpulse/.env
ExecStart=/opt/fitpulse/.venv/bin/python -u /opt/fitpulse/bot.py
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/fitpulse

[Install]
WantedBy=multi-user.target
