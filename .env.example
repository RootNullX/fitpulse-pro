# Telegram API credentials from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=replace_me

# Create a bot with @BotFather and add it as administrator to your destination channel
TG_BOT_TOKEN=123456:replace_me
TARGET_CHANNEL=@your_destination_channel

# Public Telegram channels the Telegram user account can access (comma-separated)
SOURCE_CHANNELS=@espn,@SkySports,@premierleague,@nba,@drtedros,@menshealth

# Required for English-to-Persian translation and concise Persian summaries
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

TIMEZONE=Europe/Paris
POLL_MINUTES=5
PUBLISH_INTERVAL_HOURS=6
DB_PATH=fitpulse.db
LOG_LEVEL=INFO
